{
  "name": "markdown-editor",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run tests/unit",
    "test:color": "vitest run tests/unit/color-gate.test.ts",
    "test:gate": "npm run check:tokens && npm run check:ssot && npm run check:table && npm run check:length && vitest run tests/gate tests/unit",
    "test:commonmark": "node tests/commonmark/run-compliance.mjs",
    "test:perf": "node tests/perf/baseline-collect.mjs",
    "test:measure": "node scripts/verify-physical-measure.mjs",
    "check:tokens": "node scripts/check-design-tokens.mjs",
    "check:ssot": "node scripts/check-ssot.mjs",
    "check:table": "node scripts/check-table-invariants.mjs",
    "check:length": "node scripts/check-file-length.mjs",
    "test:table": "vitest run tests/gate/table-invariants.test.ts",
    "test:table:e2e": "playwright test tests/e2e/*table*.spec.ts",
    "test:table:all": "npm run check:table && npm run test:table",
    "check:gate": "npm run check:tokens && npm run check:ssot && npm run check:length && npm run lint",
    "preview": "vite preview",
    "tauri": "tauri",
    "app:dev": "tauri dev",
    "app:build": "tauri build"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.9",
    "@tauri-apps/api": "^2.8.0",
    "chrome-remote-interface": "^0.34.0",
    "katex": "^0.18.1",
    "lucide-react": "^1.45.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tauri-apps/cli": "^2.8.4",
    "@types/katex": "^0.16.8",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
