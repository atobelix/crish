{
  "providerId": "azure-ml",
  "name": "Azure ML",
  "description": "Azure Machine Learning - model inference endpoints via AI Studio",
  "website": "https://azure.microsoft.com/products/machine-learning",
  "docsUrl": "https://learn.microsoft.com/azure/ai-studio",
  "engine": "openai-compatible",
  "baseUrl": "https://<your-endpoint>.inference.ai.azure.com/v1",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "AZURE_ML_API_KEY"
  },
  "models": [
    {
      "id": "gpt-4o",
      "capabilities": [
        "code",
        "vision",
        "tool-use",
        "reasoning",
        "long-context"
      ],
      "contextWindow": 128000,
      "maxOutputTokens": 16384,
      "costPer1kInput": 0.0025,
      "costPer1kOutput": 0.01
    },
    {
      "id": "DeepSeek-V3",
      "aliases": ["deepseek-v3"],
      "capabilities": ["code", "tool-use", "reasoning", "long-context"],
      "contextWindow": 128000,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.001,
      "costPer1kOutput": 0.001
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": true,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
