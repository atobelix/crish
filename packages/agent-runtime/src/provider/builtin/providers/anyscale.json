{
  "providerId": "anyscale",
  "name": "Anyscale",
  "description": "Anyscale Endpoints API - serverless LLM inference",
  "website": "https://anyscale.com",
  "docsUrl": "https://docs.anyscale.com",
  "engine": "openai-compatible",
  "baseUrl": "https://api.anyscale.com/v1",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "ANYSCALE_API_KEY"
  },
  "models": [
    {
      "id": "meta-llama/Llama-3.3-70B-Instruct",
      "aliases": ["llama-3.3-70b"],
      "capabilities": ["code", "tool-use", "reasoning"],
      "contextWindow": 131072,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.0009,
      "costPer1kOutput": 0.0009
    },
    {
      "id": "mistralai/Mixtral-8x22B-Instruct",
      "aliases": ["mixtral-8x22b"],
      "capabilities": ["code", "tool-use", "reasoning"],
      "contextWindow": 65536,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.001,
      "costPer1kOutput": 0.001
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": false,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
