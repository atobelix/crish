{
  "providerId": "deepinfra",
  "name": "DeepInfra",
  "description": "DeepInfra API - serverless inference for open-source models",
  "website": "https://deepinfra.com",
  "docsUrl": "https://deepinfra.com/docs",
  "engine": "openai-compatible",
  "baseUrl": "https://api.deepinfra.com/v1/openai",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "DEEPINFRA_API_KEY"
  },
  "models": [
    {
      "id": "meta-llama/Llama-3.3-70B-Instruct",
      "aliases": ["llama-3.3-70b"],
      "capabilities": ["code", "tool-use", "reasoning"],
      "contextWindow": 131072,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.00035,
      "costPer1kOutput": 0.0004
    },
    {
      "id": "mistralai/Mixtral-8x22B-Instruct",
      "aliases": ["mixtral-8x22b"],
      "capabilities": ["code", "tool-use", "reasoning"],
      "contextWindow": 65536,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.00065,
      "costPer1kOutput": 0.00065
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": false,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
