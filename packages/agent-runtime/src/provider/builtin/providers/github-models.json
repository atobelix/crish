{
  "providerId": "github-models",
  "name": "GitHub Models",
  "description": "GitHub Models API - Azure-hosted AI models via GitHub",
  "website": "https://github.com/marketplace/models",
  "docsUrl": "https://docs.github.com/en/github-models",
  "engine": "openai-compatible",
  "baseUrl": "https://models.inference.ai.azure.com",
  "auth": {
    "type": "bearer",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "GITHUB_TOKEN"
  },
  "models": [
    {
      "id": "gpt-4o",
      "capabilities": ["code", "vision", "tool-use", "reasoning"],
      "contextWindow": 128000,
      "maxOutputTokens": 16384,
      "costPer1kInput": 0,
      "costPer1kOutput": 0
    },
    {
      "id": "gpt-4o-mini",
      "capabilities": ["code", "vision", "tool-use"],
      "contextWindow": 128000,
      "maxOutputTokens": 16384,
      "costPer1kInput": 0,
      "costPer1kOutput": 0
    },
    {
      "id": "DeepSeek-V3",
      "capabilities": ["code", "reasoning"],
      "contextWindow": 128000,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0,
      "costPer1kOutput": 0
    },
    {
      "id": "phi-4",
      "capabilities": ["code", "reasoning"],
      "contextWindow": 128000,
      "maxOutputTokens": 16384,
      "costPer1kInput": 0,
      "costPer1kOutput": 0
    },
    {
      "id": "mistral-large",
      "capabilities": ["code", "tool-use"],
      "contextWindow": 128000,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0,
      "costPer1kOutput": 0
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": true,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
