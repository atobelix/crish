{
  "providerId": "friendli",
  "name": "Friendli AI",
  "description": "Friendli AI - serverless inference for generative AI",
  "website": "https://friendli.ai",
  "docsUrl": "https://docs.friendli.ai",
  "engine": "openai-compatible",
  "baseUrl": "https://inference.friendli.ai/v1",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "FRIENDLI_API_KEY"
  },
  "models": [
    {
      "id": "meta-llama-3.3-70b-instruct",
      "aliases": ["llama-3.3-70b"],
      "capabilities": ["code", "tool-use", "reasoning"],
      "contextWindow": 131072,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.0005,
      "costPer1kOutput": 0.0005
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": false,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
