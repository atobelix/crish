{
  "providerId": "writer",
  "name": "Writer",
  "description": "Writer API - Palmyra enterprise LLM models",
  "website": "https://writer.com",
  "docsUrl": "https://docs.writer.com",
  "engine": "openai-compatible",
  "baseUrl": "https://api.writer.com/v1",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "WRITER_API_KEY"
  },
  "models": [
    {
      "id": "palmyra-x-004",
      "capabilities": ["code", "tool-use", "reasoning", "long-context"],
      "contextWindow": 128000,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.002,
      "costPer1kOutput": 0.008
    },
    {
      "id": "palmyra-x-003",
      "capabilities": ["code", "tool-use", "reasoning"],
      "contextWindow": 128000,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.002,
      "costPer1kOutput": 0.008
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": false,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
