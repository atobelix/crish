{
  "providerId": "together",
  "name": "Together AI",
  "description": "Together AI API - hosted open-source models",
  "website": "https://together.ai",
  "docsUrl": "https://docs.together.ai",
  "engine": "openai-compatible",
  "baseUrl": "https://api.together.xyz/v1",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "TOGETHER_API_KEY"
  },
  "models": [
    {
      "id": "meta-llama/Llama-3.3-70B-Instruct-Turbo",
      "aliases": ["llama-3.3-70b"],
      "capabilities": ["code", "tool-use", "reasoning"],
      "contextWindow": 131072,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.00059,
      "costPer1kOutput": 0.00079
    },
    {
      "id": "deepseek-ai/DeepSeek-V3",
      "aliases": ["deepseek-v3"],
      "capabilities": ["code", "tool-use", "reasoning", "long-context"],
      "contextWindow": 128000,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.001,
      "costPer1kOutput": 0.001
    },
    {
      "id": "mistralai/Mixtral-8x22B-Instruct",
      "aliases": ["mixtral-8x22b"],
      "capabilities": ["code", "tool-use"],
      "contextWindow": 65536,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.0009,
      "costPer1kOutput": 0.0009
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": false,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
