{
  "providerId": "fireworks",
  "name": "Fireworks AI",
  "description": "Fireworks AI API - fast inference platform",
  "website": "https://fireworks.ai",
  "docsUrl": "https://docs.fireworks.ai",
  "engine": "openai-compatible",
  "baseUrl": "https://api.fireworks.ai/inference/v1",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "FIREWORKS_API_KEY"
  },
  "models": [
    {
      "id": "accounts/fireworks/models/llama-v3p3-70b-instruct",
      "aliases": ["llama-3.3-70b"],
      "capabilities": ["code", "tool-use", "reasoning"],
      "contextWindow": 131072,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.0009,
      "costPer1kOutput": 0.0009
    },
    {
      "id": "accounts/fireworks/models/deepseek-v3",
      "aliases": ["deepseek-v3"],
      "capabilities": ["code", "tool-use", "reasoning", "long-context"],
      "contextWindow": 128000,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.001,
      "costPer1kOutput": 0.001
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": false,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
