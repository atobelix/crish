{
  "providerId": "mistral",
  "name": "Mistral",
  "description": "Mistral AI API",
  "website": "https://mistral.ai",
  "docsUrl": "https://docs.mistral.ai",
  "engine": "openai-compatible",
  "baseUrl": "https://api.mistral.ai/v1",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "MISTRAL_API_KEY"
  },
  "models": [
    {
      "id": "mistral-large-2411",
      "aliases": ["mistral-large"],
      "capabilities": ["code", "tool-use", "reasoning", "long-context"],
      "contextWindow": 128000,
      "maxOutputTokens": 32768,
      "costPer1kInput": 0.002,
      "costPer1kOutput": 0.006
    },
    {
      "id": "mistral-small-2501",
      "aliases": ["mistral-small"],
      "capabilities": ["code", "tool-use"],
      "contextWindow": 128000,
      "maxOutputTokens": 32768,
      "costPer1kInput": 0.001,
      "costPer1kOutput": 0.003
    },
    {
      "id": "codestral-2501",
      "aliases": ["codestral"],
      "capabilities": ["code", "tool-use", "long-context"],
      "contextWindow": 256000,
      "maxOutputTokens": 32768,
      "costPer1kInput": 0.003,
      "costPer1kOutput": 0.009
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": false,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
