{
  "providerId": "groq",
  "name": "Groq",
  "description": "Groq API - fast inference on open-source models",
  "website": "https://groq.com",
  "docsUrl": "https://console.groq.com/docs",
  "engine": "openai-compatible",
  "baseUrl": "https://api.groq.com/openai/v1",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "GROQ_API_KEY"
  },
  "models": [
    {
      "id": "llama-3.3-70b-versatile",
      "capabilities": ["code", "tool-use", "reasoning"],
      "contextWindow": 128000,
      "maxOutputTokens": 32768,
      "costPer1kInput": 0.00059,
      "costPer1kOutput": 0.00079
    },
    {
      "id": "mixtral-8x7b-32768",
      "capabilities": ["code", "tool-use"],
      "contextWindow": 32768,
      "maxOutputTokens": 32768,
      "costPer1kInput": 0.00024,
      "costPer1kOutput": 0.00024
    },
    {
      "id": "gemma2-9b-it",
      "capabilities": ["code"],
      "contextWindow": 8192,
      "maxOutputTokens": 8192,
      "costPer1kInput": 0.0001,
      "costPer1kOutput": 0.0001
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": false,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
