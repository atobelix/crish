{
  "providerId": "lepton",
  "name": "Lepton AI",
  "description": "Lepton AI API - fast model serving and inference",
  "website": "https://lepton.ai",
  "docsUrl": "https://lepton.ai/docs",
  "engine": "openai-compatible",
  "baseUrl": "https://lepton.ai/api/v1",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "LEPTON_API_KEY"
  },
  "models": [
    {
      "id": "llama3-70b",
      "capabilities": ["code", "tool-use", "reasoning"],
      "contextWindow": 8192,
      "maxOutputTokens": 4096,
      "costPer1kInput": 0.0008,
      "costPer1kOutput": 0.0008
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": false,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
