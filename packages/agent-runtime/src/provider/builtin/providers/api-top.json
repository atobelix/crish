{
  "providerId": "api-top",
  "name": "API.top",
  "description": "API.top - unified API gateway for multiple LLM providers",
  "website": "https://apitop.com",
  "docsUrl": "https://docs.apitop.com",
  "engine": "openai-compatible",
  "baseUrl": "https://api.apitop.com/v1",
  "auth": {
    "type": "api-key",
    "placement": "header",
    "keyHeader": "Authorization",
    "defaultEnvVar": "APITOP_API_KEY"
  },
  "models": [
    {
      "id": "gpt-4o",
      "capabilities": [
        "code",
        "vision",
        "tool-use",
        "reasoning",
        "long-context"
      ],
      "contextWindow": 128000,
      "maxOutputTokens": 16384,
      "costPer1kInput": 0.0025,
      "costPer1kOutput": 0.01
    },
    {
      "id": "claude-3-opus",
      "capabilities": [
        "code",
        "vision",
        "tool-use",
        "reasoning",
        "long-context"
      ],
      "contextWindow": 200000,
      "maxOutputTokens": 4096,
      "costPer1kInput": 0.015,
      "costPer1kOutput": 0.075
    }
  ],
  "endpointType": "chat-completions",
  "capabilities": {
    "toolUse": true,
    "vision": true,
    "reasoning": true,
    "streaming": true,
    "systemPrompt": true,
    "jsonMode": true,
    "parallelToolCalls": true
  },
  "engineOptions": {
    "authHeader": "authorization",
    "maxTokensField": "max_tokens"
  }
}
