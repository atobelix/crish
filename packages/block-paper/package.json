{
  "name": "@crish/block-paper",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "块纸面呈现 chrome：静默假数据骨架 / 把手·折叠·多选·slash 状态模型（W3-C，不接真实后端）",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts packages/block-paper/src",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@crish/block-paper-contract": "*",
    "@crish/editor-kit": "*"
  }
}
