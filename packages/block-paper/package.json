{
  "name": "@crish/block-paper",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "块纸面呈现：chrome（W3-C）+ 叶子 Intent（W3-D）+ 结构 Intent slash/多选（W3-F mock apply，不接真实后端）",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src",
    "README.md"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts packages/block-paper/src",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@crish/block-paper-contract": "*",
    "@crish/editor-kit": "*"
  }
}
