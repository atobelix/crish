{
  "name": "@crish/conversation-flow",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "对话叙事投影纯函数：SessionMessage 结构 → FlowNode 树（无 UI、无 IPC）",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "build": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run --config ../../vitest.config.ts packages/conversation-flow/src",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  }
}
