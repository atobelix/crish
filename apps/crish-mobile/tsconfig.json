{
  /* crish-mobile 类型配置（D4 §9.3 / D8 §3.3.4）：
   * - extends 仓库 tsconfig.base.json（strict 全家桶），不继承 expo/tsconfig.base
   * - customConditions: ["development"] 继承自基座：@crish/shared-types 的
   *   exports 走 development 条件直出 src（D8 §1.3.1 双轨 exports）
   * - exactOptionalPropertyTypes 关闭：对齐 apps/crish-desktop/tsconfig.app.json
   *   先例（RN / expo-router 类型面与该严格项存在摩擦）
   * - typedRoutes 骨架期关闭（app.json experiments），CI 无 .expo/types 生成路径，
   *   按 D4 §9.3 后续增量开启 */
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2023", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "noEmit": true,
    "types": ["jest"],
    "exactOptionalPropertyTypes": false,
    "paths": {
      "@/*": ["./src/*"],
      "@/assets/*": ["./assets/*"]
    }
  },
  "include": ["**/*.ts", "**/*.tsx"]
}
