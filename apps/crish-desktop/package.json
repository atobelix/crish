{
  "name": "@crish/crish-desktop",
  "private": true,
  "license": "MIT",
  "version": "0.1.1",
  "type": "module",
  "description": "Crish desktop UI (consumer client)",
  "scripts": {
    "predev": "node ../../scripts/ensure-dev-ports.mjs",
    "dev": "node ../../node_modules/vite/bin/vite.js --force",
    "build": "node ../../node_modules/typescript/bin/tsc -b && node ../../node_modules/vite/bin/vite.js build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "test:snapshots": "vitest run --root ../.. --project unit apps/crish-desktop/tests/snapshots/ --coverage.enabled=false",
    "test:snapshots:update": "vitest run --root ../.. --project unit apps/crish-desktop/tests/snapshots/ --update --coverage.enabled=false",
    "test:visual": "playwright test",
    "test:visual:update": "playwright test --update-snapshots",
    "test:e2e": "npx playwright test --config ../../playwright.config.ts"
  },
  "dependencies": {
    "@chenglou/pretext": "^0.0.8",
    "@crish/block-paper": "file:../../packages/block-paper",
    "@crish/block-paper-contract": "file:../../packages/block-paper-contract",
    "@crish/conversation-flow": "file:../../packages/conversation-flow",
    "@crish/editor-kit": "file:../../packages/editor-kit",
    "@crish/shared-types": "file:../../packages/shared-types",
    "@crish/shared-utils": "file:../../packages/shared-utils",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@fontsource/ibm-plex-sans": "^5.2.8",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/jetbrains-mono": "^5.2.8",
    "@hugeicons/core-free-icons": "^4.3.2",
    "@hugeicons/react": "^1.1.10",
    "@radix-ui/react-dismissable-layer": "^1.1.19",
    "@radix-ui/react-popover": "^1.1.23",
    "@tauri-apps/api": "^2.8.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "@tiptap/core": "^3.31.4",
    "@tiptap/extension-link": "^3.31.4",
    "@tiptap/extension-placeholder": "^3.31.4",
    "@tiptap/pm": "^3.31.4",
    "@tiptap/react": "^3.31.4",
    "@tiptap/starter-kit": "^3.31.4",
    "@tiptap/suggestion": "^3.31.4",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "dompurify": "^3.4.16",
    "highlight.js": "^11.11.1",
    "immer": "^11.1.8",
    "marked": "^18.0.11",
    "motion": "^13.2.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "tauri-plugin-mcp": "^0.3.1",
    "use-sync-external-store": "^1.6.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.1.9",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "jsdom": "^29.1.1",
    "typescript": "^5.9.2",
    "vite": "^7.1.5"
  }
}
