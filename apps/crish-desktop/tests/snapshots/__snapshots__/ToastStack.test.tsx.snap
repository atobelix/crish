exports[`ToastStack snapshots > renders toast with undo 1`] = `
<div
  class="_toastStack_9bce87"
>
  <div
    aria-live="assertive"
    class="_toastAlert_9bce87"
    role="status"
  >
    <span>
      文件已删除
    </span>
    <button
      class="_button_ae1db5 _buttonSecondary_ae1db5 _buttonSm_ae1db5 _toastUndoBtn_9bce87"
      type="button"
    >
      <span
        class="_buttonLabel_ae1db5"
      >
        撤销
      </span>
    </button>
    <button
      aria-label="关闭通知"
      class="_button_ae1db5 _buttonGhost_ae1db5 _buttonSm_ae1db5 _toastDismissBtn_9bce87"
      type="button"
    >
      <span
        aria-hidden="true"
        class="_buttonIcon_ae1db5"
      >
        <span
          aria-hidden="true"
        >
          ×
        </span>
      </span>
    </button>
  </div>
</div>
`;
