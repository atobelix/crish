// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`ToastStack snapshots > renders multiple toasts 1`] = `
<div
  class="_toastStack_9bcf44"
>
  <div
    aria-live="polite"
    class="_toastAlert_9bcf44"
    role="status"
  >
    <span>
      第一条通知
    </span>
    <button
      aria-label="关闭通知"
      class="_toastDismissBtn_9bcf44"
      type="button"
    >
      <span
        aria-hidden="true"
      >
        ×
      </span>
    </button>
  </div>
  <div
    aria-live="polite"
    class="_toastAlert_9bcf44"
    role="status"
  >
    <span>
      第二条通知
    </span>
    <button
      aria-label="关闭通知"
      class="_toastDismissBtn_9bcf44"
      type="button"
    >
      <span
        aria-hidden="true"
      >
        ×
      </span>
    </button>
  </div>
  <div
    aria-live="polite"
    class="_toastAlert_9bcf44"
    role="status"
  >
    <span>
      警告信息
    </span>
    <button
      aria-label="关闭通知"
      class="_toastDismissBtn_9bcf44"
      type="button"
    >
      <span
        aria-hidden="true"
      >
        ×
      </span>
    </button>
  </div>
</div>
`;

