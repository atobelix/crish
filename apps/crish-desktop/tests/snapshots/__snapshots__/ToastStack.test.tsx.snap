exports[`ToastStack snapshots > renders toast with undo 1`] = `
<div
  class="_toastStack_9bcf44"
>
  <div
    aria-live="assertive"
    class="_toastAlert_9bcf44"
    role="status"
  >
    <span>
      文件已删除
    </span>
    <button
      class="_toastUndoBtn_9bcf44"
      type="button"
    >
      撤销
    </button>
    <button
      aria-label="关闭通知"
      class="_toastDismissBtn_9bcf44"
      type="button"
    >
      <span
        aria-hidden="true"
      >
        ×
      </span>
    </button>
  </div>
</div>
`;
