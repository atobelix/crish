{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Crish Agent Workbench",
  "version": "0.1.0",
  "identifier": "me.flowbit.crish",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5194",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Crish Agent Workbench",
        "width": 1320,
        "height": 880,
        "minWidth": 1040,
        "minHeight": 720,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "active": false,
    "targets": "all",
    "icon": [
      "../../desktop/src-tauri/icons/icon.ico"
    ]
  }
}
