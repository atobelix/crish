# Crish / Conex Environment Configuration Example
# Copy this file to .env or .env.local to customize your development environment.

# ==============================================================================
# Model Provider API Keys (Optional - Can also be configured directly in App Settings)
# ==============================================================================
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GEMINI_API_KEY=AIzaSy...
# DEEPSEEK_API_KEY=sk-...

# ==============================================================================
# Rust Engine & Logging
# ==============================================================================
# RUST_LOG=info,session_loop=debug,orchestrator=debug
# CRISH_LOG_LEVEL=info

# ==============================================================================
# Frontend & Developer Settings
# ==============================================================================
# VITE_ALLOW_DEMO=1        # Allow demo mode in development
# VITE_DEV_PORT=5174       # UI Vite development port
