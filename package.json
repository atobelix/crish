{
  "name": "crish",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "description": "Crish - Tauri Workbench and agent daemon runtime",
  "workspaces": [
    "apps/crish-desktop",
    "apps/agent-workbench",
    "packages/agent-runtime",
    "packages/agent-orchestrator",
    "packages/agent-daemon",
    "packages/shared-types",
    "packages/shared-utils",
    "packages/decision-engine"
  ],
  "scripts": {
    "dev:desktop": "npm --workspace @crish/crish-desktop run dev",
    "dev:workbench": "npm --workspace @crish/agent-workbench run tauri -- dev",
    "dev:cli": "npm --workspace @crish/agent-workbench run cli",
    "build:desktop": "npm --workspace @crish/crish-desktop run build",
    "build:workbench": "npm run check:workbench && npm --workspace @crish/agent-workbench run build",
    "build:shared-types": "npm --workspace @crish/shared-types run build",
    "build:runtime": "npm --workspace @crish/agent-runtime run build",
    "build:orchestrator": "npm --workspace @crish/agent-orchestrator run build",
    "build:packages": "npm run build:shared-types && npm --workspace @crish/shared-utils run build && npm --workspace @crish/decision-engine run build && npm run build:runtime && npm run build:orchestrator",
    "build:daemon": "npm run build:packages && npm --workspace @crish/agent-daemon run build",
    "build:daemon-binary": "node scripts/bundle-daemon.mjs",
    "build:product": "npm run build:daemon && npm run build:desktop && npm run build:daemon-binary",
    "cli": "npm run dev:cli",
    "daemon": "tsx --conditions development packages/agent-daemon/src/index.ts",
    "daemon:dist": "node packages/agent-daemon/dist/index.js",
    "bench:daemon": "node packages/agent-daemon/scripts/benchmark-daemon-startup.mjs",
    "bench": "npx tsx packages/shared-utils/src/bench/run-benchmarks.ts",
    "bench:mem": "node --expose-gc --import tsx packages/shared-utils/src/bench/run-mem-benchmarks.ts",
    "bench:ci": "npm run bench && npm run bench:mem && npx tsx scripts/compare-benchmarks.ts",
    "bench:acceptance": "npx tsx scripts/acceptance-criteria.ts",
    "bench:report": "npx tsx scripts/generate-perf-report.ts",
    "stress": "npx tsx tests/stress/run-all-stress.ts",
    "stress:ai": "npx tsx tests/stress/stress-ai-stream.ts",
    "stress:diff": "npx tsx tests/stress/stress-diff-load.ts",
    "stress:session": "npx tsx tests/stress/stress-session-switch.ts",
    "startup:cold": "npx tsx tests/startup/measure-cold-start.ts",
    "startup:warm": "npx tsx tests/startup/measure-warm-start.ts",
    "perf:all": "npm run bench && npm run bench:mem && npm run bench:acceptance && npm run bench:report",
    "check:core": "npm run check:runtime && npm run check:orchestrator && npm run check:daemon && npm run check:workbench && npm run check:desktop",
    "check:runtime": "tsc -p packages/agent-runtime/tsconfig.json --noEmit",
    "check:orchestrator": "tsc -p packages/agent-orchestrator/tsconfig.json --noEmit",
    "check:daemon": "tsc -p packages/agent-daemon/tsconfig.json --noEmit",
    "check:workbench": "npm --workspace @crish/agent-workbench run cli:check",
    "check:desktop": "npm --workspace @crish/crish-desktop run typecheck",
    "check:store-types": "node scripts/check-no-as-any-store.mjs",
    "test:core": "vitest run packages/agent-runtime/src packages/agent-orchestrator/src packages/agent-daemon/src",
    "test:desktop-helpers": "vitest run apps/crish-desktop/src/api apps/crish-desktop/src/store",
    "test": "vitest run",
    "lint:css": "npx --yes stylelint@16 \"apps/crish-desktop/src/styles/**/*.css\"",
    "lint": "eslint .",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^25.6.0",
    "esbuild": "^0.27.7",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^15.15.0",
    "prettier": "^3.5.1",
    "tsc-alias": "^1.8.16",
    "typescript-eslint": "^8.25.0",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "dependencies": {
    "ws": "^8.21.0"
  }
}
