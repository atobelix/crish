{
  "name": "crish",
  "version": "0.1.1",
  "private": true,
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": "^24.3.0",
    "npm": "^11.6.2"
  },
  "license": "MIT",
  "description": "Crish — Tauri desktop AI agent workbench (Rust engine, React UI)",
  "workspaces": [
    "apps/crish-desktop",
    "apps/agent-workbench",
    "apps/crish-mobile",
    "packages/plugin-import-claude-codex",
    "packages/shared-types",
    "packages/shared-utils",
    "packages/test-utils",
    "packages/block-paper-contract",
    "packages/editor-kit",
    "packages/block-paper",
    "packages/conversation-flow"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "clean:cargo-cache": "pwsh -ExecutionPolicy Bypass -File scripts/clean-cargo-cache.ps1",
    "prepare": "husky",
    "dev:desktop": "npm --workspace @crish/crish-desktop run dev",
    "dev:workbench": "node scripts/ensure-dev-ports.mjs && npm --workspace @crish/agent-workbench run tauri -- dev",
    "build:desktop": "npm --workspace @crish/crish-desktop run build",
    "build:workbench": "npm run check:workbench && npm --workspace @crish/agent-workbench run build",
    "build:shared-types": "npm --workspace @crish/shared-types run build",
    "gen:engine-bindings": "node scripts/generate-engine-bindings.mjs",
    "build:packages": "turbo run build --filter=\"./packages/*\"",
    "bench": "npx tsx packages/shared-utils/src/bench/run-benchmarks.ts",
    "bench:mem": "node --expose-gc --import tsx packages/shared-utils/src/bench/run-mem-benchmarks.ts",
    "bench:ab": "npx tsx scripts/perf-ab.ts",
    "bench:ci": "npm run bench && npm run bench:mem && npm run bench:ab && npx tsx scripts/compare-benchmarks.ts",
    "bench:acceptance": "npx tsx scripts/acceptance-criteria.ts",
    "bench:report": "npx tsx scripts/generate-perf-report.ts",
    "typecheck:perf": "tsc --noEmit -p scripts/tsconfig.perf.json",
    "perf:block-workspace": "npx tsx scripts/block-workspace-perf.mjs",
    "stress": "npx tsx --conditions=development tests/stress/run-all-stress.ts",
    "stress:ai": "npx tsx --conditions=development tests/stress/stress-ai-stream.ts",
    "stress:diff": "npx tsx --conditions=development tests/stress/stress-diff-load.ts",
    "stress:session": "npx tsx --conditions=development tests/stress/stress-session-switch.ts",
    "startup:cold": "npx tsx tests/startup/measure-cold-start.ts",
    "startup:warm": "npx tsx tests/startup/measure-warm-start.ts",
    "check:workbench": "npm --workspace @crish/agent-workbench run cli:check",
    "typecheck": "tsc --noEmit -p apps/crish-desktop/tsconfig.app.json && tsc --noEmit -p apps/crish-desktop/tsconfig.node.json && tsc --noEmit -p apps/agent-workbench/tsconfig.json && tsc --noEmit -p packages/shared-types && tsc --noEmit -p packages/shared-utils && tsc --noEmit -p packages/block-paper-contract && tsc --noEmit -p packages/editor-kit && tsc --noEmit -p packages/block-paper && tsc --noEmit -p packages/conversation-flow && tsc --noEmit -p packages/plugin-import-claude-codex && tsc --noEmit -p packages/test-utils",
    "diff:all": "node scripts/show-full-diff.mjs",
    "diff:save": "node scripts/show-full-diff.mjs --silent --out .agent-outputs/workspace-full-diff.patch",
    "check:runtime-status-ssot": "node scripts/check-runtime-status-ssot.mjs",
    "check:desktop": "npm run check:runtime-status-ssot && npm run check:convergence && npm --workspace @crish/crish-desktop run typecheck && npm run check:ui-layer && npm run check:line-counts && npm run check:input-guard && npm run check:text-color && npm run check:icon-ssot && npm run check:line-width-ssot && npm run check:color-ssot && npm run check:preferences-ssot && npm run check:markdown-style && npm run check:no-pseudo-dispatch && npm run check:blocked-executable-ssot && npm run check:no-nonvision-dataurl && npm run check:swallowed-errors-frontend && npm run check:sec6-note-drain-entropy && npm run check:token-consistency && npm run check:layout-tokens && npm run check:token-fallback-drift && npm run check:inline-style-hardcode && npm run check:tooltip-hygiene && npm run check:layout-geometry && npm run check:store-islands && npm run check:perf-budgets && npm run check:startup-budget && npm run check:model-config-ssot && npm run check:i18n && npm run check:chat-render-contract",
    "check:i18n:hardcoded": "node scripts/check-i18n-hardcoded.mjs",
    "check:i18n:symmetry": "node scripts/check-i18n-symmetry.mjs",
    "check:i18n:unused": "node scripts/check-i18n-unused-keys.mjs",
    "check:i18n": "npm run check:i18n:symmetry && npm run check:i18n:unused && npm run check:i18n:hardcoded",
    "check:chat-render-contract": "vitest run --project unit apps/crish-desktop/src/api/userFacingErrors.test.ts apps/crish-desktop/src/api/tool-presentation/timelineNormalizer.test.ts apps/crish-desktop/src/api/tool-presentation/__tests__/assistantRenderability.test.ts apps/crish-desktop/src/components/chat-card/useChatMessages.test.ts apps/crish-desktop/src/components/chat-card/__tests__/projectDisplayMessages.test.ts apps/crish-desktop/src/components/chat-message/MessageContent.renderability.contract.test.tsx apps/crish-desktop/src/components/chat-message/__tests__/contextStateUtils.test.ts apps/crish-desktop/src/components/chat-message-list/__tests__/ChatMessageList.hooksOrder.source.test.ts apps/crish-desktop/src/api/chat-bridge/ConnectionLifecycle.test.ts apps/crish-desktop/src/api/sessionStreamManager.test.ts apps/crish-desktop/src/hooks/chat-stream/useGoalMode.busyRetry.test.ts apps/crish-desktop/src/api/runControlClient.test.ts apps/crish-desktop/src/api/VirtualScrollManager.test.ts apps/crish-desktop/src/hooks/useVirtualScroll.gesture.test.ts apps/crish-desktop/src/api/sessionTitle.test.ts apps/crish-desktop/src/api/sessionTitle.adversarial.test.ts apps/crish-desktop/src/components/sidebar/session-list/SessionRow.test.tsx apps/crish-desktop/src/components/chat-message-row/__tests__/actionBarOverlay.contract.test.ts apps/crish-desktop/src/api/VirtualScrollManager.rowGap.contract.test.ts apps/crish-desktop/src/api/sessionTitleSource.test.ts apps/crish-desktop/src/api/sessionListTitleHint.test.ts apps/crish-desktop/src/api/sessionAiTitle.test.ts apps/crish-desktop/src/api/contextStateDiff.test.ts",
    "check:perf-budgets": "node scripts/check-perf-budgets.mjs",
    "check:async-commands": "node scripts/check-async-commands.mjs",
    "check:gatekeeper-shared": "node scripts/check-gatekeeper-shared.mjs",
    "check:tooltip-hygiene": "node scripts/check-tooltip-hygiene.mjs",
    "check:layout-geometry": "node scripts/check-layout-geometry.mjs",
    "check:layout-tokens": "node scripts/check-layout-tokens.mjs",
    "check:token-fallback-drift": "node scripts/check-token-fallback-drift.mjs",
    "check:inline-style-hardcode": "node scripts/check-inline-style-hardcode.mjs",
    "check:convergence": "node scripts/check-frontend-convergence.mjs",
    "check:model-config-ssot": "node scripts/check-model-config-ssot.mjs",
    "check:ui-layer": "node scripts/check-ui-layer.mjs",
    "check:line-counts": "node scripts/check-line-counts.mjs --all",
    "check:input-guard": "node scripts/check-input-guardrails.mjs",
    "check:store-islands": "node scripts/check-store-islands.mjs",
    "check:startup-budget": "node scripts/check-startup-budget.mjs",
    "check:startup-reflow": "node scripts/check-reflow-guards.mjs",
    "check:text-color": "node scripts/check-text-color-tokens.mjs",
    "check:icon-ssot": "node scripts/check-icon-ssot.mjs",
    "check:line-width-ssot": "node scripts/check-line-width-ssot.mjs",
    "check:color-ssot": "node scripts/check-color-ssot.mjs",
    "check:preferences-ssot": "node scripts/check-preferences-ssot.mjs",
    "check:markdown-style": "node scripts/check-markdown-style-compliance.mjs",
    "check:no-pseudo-dispatch": "node scripts/check-no-pseudo-dispatch.mjs",
    "check:blocked-executable-ssot": "node scripts/check-blocked-executable-ssot.mjs",
    "check:no-nonvision-dataurl": "node scripts/check-no-nonvision-dataurl.mjs",
    "check:referenced-files-tracked": "node scripts/check-referenced-files-tracked.mjs",
    "check:conflict-markers": "node scripts/check-conflict-markers.mjs",
    "check:swallowed-errors-frontend": "node scripts/check-swallowed-errors-frontend.mjs --report",
    "check:css-encoding": "node scripts/check-css-encoding.mjs --whitelist-dirty-check",
    "check:chunk-cycles": "node scripts/check-chunk-cycles.mjs",
    "check:npm-licenses": "node scripts/check-npm-licenses.mjs",
    "check:store-types": "node scripts/check-no-as-any-store.mjs",
    "check:store-writes": "node scripts/check-no-raw-setstate.mjs",
    "check:store-facade": "node scripts/check-store-facade.mjs",
    "check:conex-db-size": "node scripts/check-conex-db-size.mjs",
    "check:conex-db": "npm run check:conex-db-size && npm run test:conex-db",
    "test:conex-db": "cargo test -p conex-db",
    "test:desktop-helpers": "vitest run apps/crish-desktop/src/api apps/crish-desktop/src/store",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npx playwright test tests/e2e",
    "test:e2e:smoke": "npx playwright test tests/e2e/full-journey.spec.ts tests/e2e/error-path.spec.ts tests/e2e/session-restore.spec.ts tests/e2e/cache-metrics.spec.ts tests/e2e/cache-telemetry.spec.ts",
    "test:e2e:native": "vitest run tests/e2e/tauri-native-smoke.spec.ts",
    "test:e2e:webview": "npx playwright test --config tests/e2e/webview/playwright.config.ts",
    "lint:all": "eslint . --ext .ts,.tsx --max-warnings 0 && npx --yes stylelint@16 \"apps/crish-desktop/src/**/*.css\"",
    "lint": "eslint .",
    "knip": "knip",
    "lint:depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "check:all": "npm run typecheck && npm run lint:all && npm run test:coverage",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:sec6-note-drain-entropy": "node scripts/check-sec6-note-drain-entropy.mjs",
    "check:token-consistency": "node scripts/check-token-consistency.mjs",
    "check:repo-integrity": "node scripts/check-repo-integrity.mjs",
    "check:guard-system": "node scripts/check-guard-system.mjs",
    "check:token-ssot": "node scripts/check-token-ssot.mjs",
    "check:tokens-all": "node scripts/check-tokens-all.mjs",
    "check:session-upsert": "node scripts/check-session-message-upsert.mjs",
    "check:tool-pairing": "node scripts/check-tool-pairing-invariants.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "^3.23.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.1.0",
    "prettier": "^3.5.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.4",
    "turbo": "^2.10.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "compression": "^1.8.2",
    "esbuild": "^0.28.1",
    "fast-uri": "^3.1.8",
    "prosemirror-view": "^1.42.6",
    "shell-quote": "^1.12.0",
    "smol-toml": "^1.9.1",
    "source-map-js": "^1.2.2",
    "tinypool": "^2.2.0",
    "undici": "^7.29.1"
  }
}
