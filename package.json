{
  "name": "crish",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "license": "MIT",
  "description": "Crish — Tauri desktop AI agent workbench (Rust engine, React UI)",
  "workspaces": [
    "apps/crish-desktop",
    "apps/agent-workbench",
    "apps/crish-mobile",
    "packages/plugin-import-claude-codex",
    "packages/shared-types",
    "packages/shared-utils",
    "packages/test-utils",
    "packages/block-paper-contract",
    "packages/editor-kit",
    "packages/block-paper",
    "packages/conversation-flow"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "prepare": "husky",
    "dev:desktop": "npm --workspace @crish/crish-desktop run dev",
    "dev:workbench": "node scripts/ensure-dev-ports.mjs && npm --workspace @crish/agent-workbench run tauri -- dev",
    "build:desktop": "npm --workspace @crish/crish-desktop run build",
    "build:workbench": "npm run check:workbench && npm --workspace @crish/agent-workbench run build",
    "build:shared-types": "npm --workspace @crish/shared-types run build",
    "gen:engine-bindings": "node scripts/generate-engine-bindings.mjs",
    "build:packages": "turbo run build --filter='./packages/*'",
    "bench": "npx tsx packages/shared-utils/src/bench/run-benchmarks.ts",
    "bench:mem": "node --expose-gc --import tsx packages/shared-utils/src/bench/run-mem-benchmarks.ts",
    "bench:ci": "npm run bench && npm run bench:mem && npx tsx scripts/compare-benchmarks.ts",
    "bench:acceptance": "npx tsx scripts/acceptance-criteria.ts",
    "bench:report": "npx tsx scripts/generate-perf-report.ts",
    "perf:block-workspace": "npx tsx scripts/block-workspace-perf.mjs",
    "stress": "npx tsx tests/stress/run-all-stress.ts",
    "stress:ai": "npx tsx tests/stress/stress-ai-stream.ts",
    "stress:diff": "npx tsx tests/stress/stress-diff-load.ts",
    "stress:session": "npx tsx tests/stress/stress-session-switch.ts",
    "startup:cold": "npx tsx tests/startup/measure-cold-start.ts",
    "startup:warm": "npx tsx tests/startup/measure-warm-start.ts",
    "check:workbench": "npm --workspace @crish/agent-workbench run cli:check",
    "typecheck": "tsc --noEmit -p apps/crish-desktop/tsconfig.app.json && tsc --noEmit -p apps/crish-desktop/tsconfig.node.json && tsc --noEmit -p apps/agent-workbench/tsconfig.json && tsc --noEmit -p packages/shared-types && tsc --noEmit -p packages/shared-utils",
    "check:desktop": "npm run check:convergence && npm --workspace @crish/crish-desktop run typecheck && npm run check:ui-layer && npm run check:line-counts && npm run check:input-guard && npm run check:text-color && npm run check:icon-ssot && npm run check:line-width-ssot && npm run check:color-ssot && npm run check:preferences-ssot && npm run check:markdown-style && npm run check:no-pseudo-dispatch && npm run check:blocked-executable-ssot && npm run check:no-nonvision-dataurl && npm run check:swallowed-errors-frontend && npm run check:sec6-note-drain-entropy && npm run check:token-consistency && npm run check:layout-tokens && npm run check:token-fallback-drift && npm run check:inline-style-hardcode && npm run check:tooltip-hygiene && npm run check:layout-geometry",
    "check:tooltip-hygiene": "node scripts/check-tooltip-hygiene.mjs",
    "check:layout-geometry": "node scripts/check-layout-geometry.mjs",
    "check:layout-tokens": "node scripts/check-layout-tokens.mjs",
    "check:token-fallback-drift": "node scripts/check-token-fallback-drift.mjs",
    "check:inline-style-hardcode": "node scripts/check-inline-style-hardcode.mjs",
    "check:convergence": "node scripts/check-frontend-convergence.mjs",
    "check:ui-layer": "node scripts/check-ui-layer.mjs",
    "check:line-counts": "node scripts/check-line-counts.mjs --all",
    "check:input-guard": "node scripts/check-input-guardrails.mjs",
    "check:text-color": "node scripts/check-text-color-tokens.mjs",
    "check:icon-ssot": "node scripts/check-icon-ssot.mjs",
    "check:line-width-ssot": "node scripts/check-line-width-ssot.mjs",
    "check:color-ssot": "node scripts/check-color-ssot.mjs",
    "check:preferences-ssot": "node scripts/check-preferences-ssot.mjs",
    "check:markdown-style": "node scripts/check-markdown-style-compliance.mjs",
    "check:no-pseudo-dispatch": "node scripts/check-no-pseudo-dispatch.mjs",
    "check:blocked-executable-ssot": "node scripts/check-blocked-executable-ssot.mjs",
    "check:no-nonvision-dataurl": "node scripts/check-no-nonvision-dataurl.mjs",
    "check:conflict-markers": "node scripts/check-conflict-markers.mjs",
    "check:swallowed-errors-frontend": "node scripts/check-swallowed-errors-frontend.mjs --report",
    "check:css-encoding": "node scripts/check-css-encoding.mjs --whitelist-dirty-check",
    "check:chunk-cycles": "node scripts/check-chunk-cycles.mjs",
    "check:store-types": "node scripts/check-no-as-any-store.mjs",
    "check:store-writes": "node scripts/check-no-raw-setstate.mjs",
    "check:store-facade": "node scripts/check-store-facade.mjs",
    "check:conex-db-size": "node scripts/check-conex-db-size.mjs",
    "check:conex-db": "npm run check:conex-db-size && npm run test:conex-db",
    "test:conex-db": "cargo test -p conex-db",
    "test:desktop-helpers": "vitest run apps/crish-desktop/src/api apps/crish-desktop/src/store",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "npx playwright test tests/e2e",
    "test:e2e:smoke": "npx playwright test tests/e2e/ast-block-tables.spec.ts tests/e2e/cache-metrics.spec.ts tests/e2e/cache-telemetry.spec.ts tests/e2e/format-checker.spec.ts tests/e2e/wysiwyg-interaction.spec.ts",
    "test:e2e:native": "vitest run tests/e2e/tauri-native-smoke.spec.ts",
    "test:e2e:webview": "npx playwright test --config tests/e2e/webview/playwright.config.ts",
    "lint:all": "eslint . --ext .ts,.tsx --max-warnings 0 && npx --yes stylelint@16 \"apps/crish-desktop/src/**/*.css\"",
    "lint": "eslint .",
    "knip": "knip",
    "lint:depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "check:all": "npm run typecheck && npm run lint:all && npm run test:coverage",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "check:sec6-note-drain-entropy": "node scripts/check-sec6-note-drain-entropy.mjs",
    "check:token-consistency": "node scripts/check-token-consistency.mjs",
    "check:repo-integrity": "node scripts/check-repo-integrity.mjs",
    "check:guard-system": "node scripts/check-guard-system.mjs",
    "check:token-ssot": "node scripts/check-token-ssot.mjs",
    "check:tokens-all": "node scripts/check-tokens-all.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@playwright/test": "^1.61.1",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "^3.23.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "knip": "^6.32.0",
    "lint-staged": "^17.1.0",
    "prettier": "^3.5.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.4",
    "turbo": "^2.10.8",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}": [
      "git diff --check"
    ]
  }
}
