{
  "name": "crish",
  "version": "0.1.0",
  "private": true,
  "packageManager": "npm@11.6.2",
  "license": "MIT",
  "description": "Crish — Tauri desktop AI agent workbench (Rust engine, React UI)",
  "workspaces": [
    "apps/crish-desktop",
    "apps/agent-workbench",
    "packages/logger",
    "packages/plugin-sdk",
    "packages/shared-types",
    "packages/shared-utils",
    "packages/telemetry",
    "packages/test-utils"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "prepare": "husky",
    "dev:desktop": "npm --workspace @crish/crish-desktop run dev",
    "dev:workbench": "npm --workspace @crish/agent-workbench run tauri -- dev",
    "build:desktop": "npm --workspace @crish/crish-desktop run build",
    "build:workbench": "npm run check:workbench && npm --workspace @crish/agent-workbench run build",
    "build:shared-types": "npm --workspace @crish/shared-types run build",
    "gen:engine-bindings": "node scripts/generate-engine-bindings.mjs",
    "build:packages": "turbo run build --filter='./packages/*'",
    "bench": "npx tsx packages/shared-utils/src/bench/run-benchmarks.ts",
    "bench:mem": "node --expose-gc --import tsx packages/shared-utils/src/bench/run-mem-benchmarks.ts",
    "bench:ci": "npm run bench && npm run bench:mem && npx tsx scripts/compare-benchmarks.ts",
    "bench:acceptance": "npx tsx scripts/acceptance-criteria.ts",
    "bench:report": "npx tsx scripts/generate-perf-report.ts",
    "stress": "npx tsx tests/stress/run-all-stress.ts",
    "stress:ai": "npx tsx tests/stress/stress-ai-stream.ts",
    "stress:diff": "npx tsx tests/stress/stress-diff-load.ts",
    "stress:session": "npx tsx tests/stress/stress-session-switch.ts",
    "startup:cold": "npx tsx tests/startup/measure-cold-start.ts",
    "startup:warm": "npx tsx tests/startup/measure-warm-start.ts",
    "perf:all": "npm run bench && npm run bench:mem && npm run bench:acceptance && npm run bench:report",
    "check:workbench": "npm --workspace @crish/agent-workbench run cli:check",
    "typecheck:ci": "turbo run typecheck",
    "typecheck": "tsc --noEmit -p apps/crish-desktop/tsconfig.app.json && tsc --noEmit -p apps/crish-desktop/tsconfig.node.json && tsc --noEmit -p apps/agent-workbench/tsconfig.json && tsc --noEmit -p packages/logger && tsc --noEmit -p packages/shared-types && tsc --noEmit -p packages/shared-utils && tsc --noEmit -p packages/telemetry",
    "check:desktop": "npm --workspace @crish/crish-desktop run typecheck && npm run check:ui-layer",
    "check:ui-layer": "node scripts/check-ui-layer.mjs",
    "check:store-types": "node scripts/check-no-as-any-store.mjs",
    "check:no-any": "node scripts/check-no-as-any-store.mjs",
    "check:conex-db-size": "node scripts/check-conex-db-size.mjs",
    "check:conex-db": "npm run check:conex-db-size && npm run test:conex-db",
    "test:conex-db": "cargo test -p conex-db",
    "test:desktop-helpers": "vitest run apps/crish-desktop/src/api apps/crish-desktop/src/store",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:fuzz": "vitest run tests/fuzz --reporter=verbose || echo 'No fuzz tests found'",
    "test:e2e": "npx playwright test tests/e2e",
    "test:e2e:all": "node scripts/run-full-e2e-suite.mjs",
    "test:e2e:audit": "node scripts/audit-ui-runtime-errors.mjs",
    "test:e2e:native": "vitest run tests/e2e/tauri-native-smoke.spec.ts",
    "test:real-api": "node scripts/test-real-provider-api.mjs",
    "lint:all": "eslint . --ext .ts,.tsx --max-warnings 0 && stylelint 'apps/crish-desktop/src/**/*.css'",
    "lint:css": "npx --yes stylelint@16 \"apps/crish-desktop/src/styles/**/*.css\"",
    "lint": "eslint .",
    "lint:depcruise": "depcruise --config .dependency-cruiser.cjs packages apps",
    "check:deps": "npm run lint:depcruise",
    "check:all": "npm run typecheck && npm run lint:all && npm run test:coverage",
    "format": "prettier --check .",
    "format:write": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/node": "^25.6.0",
    "@vitest/coverage-v8": "^3.2.7",
    "dependency-cruiser": "^16.10.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.21.0",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "fast-check": "^3.23.2",
    "globals": "^15.15.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.1.0",
    "prettier": "^3.5.1",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.22.4",
    "typescript": "^5.9.2",
    "typescript-eslint": "^8.25.0",
    "vitest": "^3.2.4"
  },
  "overrides": {
    "esbuild": "^0.28.1"
  },
  "dependencies": {},
  "vitest": {
    "coverage": {
      "enabled": true,
      "thresholds": {
        "statements": 50,
        "branches": 40,
        "functions": 50,
        "lines": 50
      }
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css}": [
      "prettier --write"
    ],
    "*.{ts,tsx,js,mjs,cjs,json,md,yml,yaml,css}": [
      "git diff --check"
    ]
  }
}
